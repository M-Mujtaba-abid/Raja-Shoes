// Raja Shoes - Prisma Schema for Neon DB (PostgreSQL)
// Run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── INVENTORY ───────────────────────────────────────────────────────────────
model Product {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  dateAdded   DateTime    @default(now())
  articleName String
  size        String
  quantity    Int         @default(0)
  costPrice   Decimal     @db.Decimal(10, 2)
  salePrice   Decimal     @db.Decimal(10, 2)
  status      StockStatus @default(IN_STOCK)
  notes       String?

  invoiceItems InvoiceItem[]
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
}

// ─── INVOICES / POS ──────────────────────────────────────────────────────────
model Invoice {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  invoiceNo    String        @unique
  customerName String
  grandTotal   Decimal       @db.Decimal(10, 2)
  totalCost    Decimal       @db.Decimal(10, 2)
  grossProfit  Decimal       @db.Decimal(10, 2)
  notes        String?

  items        InvoiceItem[]
  khataEntry   KhataAccount?
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String
  articleName String
  size        String
  quantity    Int
  costPrice   Decimal  @db.Decimal(10, 2)
  salePrice   Decimal  @db.Decimal(10, 2)
  itemProfit  Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

// ─── KHATA (LEDGER / CREDIT) ─────────────────────────────────────────────────
model KhataAccount {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customerName    String
  phone           String?
  invoiceId       String?   @unique
  totalBillAmount Decimal   @db.Decimal(10, 2)
  totalPaid       Decimal   @default(0) @db.Decimal(10, 2)
  remainingBalance Decimal  @db.Decimal(10, 2)
  status          KhataStatus @default(PENDING)
  notes           String?

  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  payments        KhataPayment[]
}

model KhataPayment {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  accountId    String
  amount       Decimal      @db.Decimal(10, 2)
  date         DateTime     @default(now())
  notes        String?

  account      KhataAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

enum KhataStatus {
  PENDING
  PARTIAL
  CLEARED
}

// ─── EXPENSES ─────────────────────────────────────────────────────────────────
model Expense {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  date      DateTime        @default(now())
  amount    Decimal         @db.Decimal(10, 2)
  category  ExpenseCategory
  notes     String?
}

enum ExpenseCategory {
  SALARY
  TAYA_JEE
  MUNEEB
  CZN
  OTHER
}
